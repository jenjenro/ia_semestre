<graph edgedefault="directed"><node id="DocumentoDigital">
  <data key="d0">Entidad</data>
  <data key="d1">Archivo digital o texto ingresado al sistema documental.</data>
</node>
<node id="RedNeuronal">
  <data key="d0">AgenteIA</data>
  <data key="d1">Modelo de Perceptrón Multicapa (MLP) que procesa patrones y genera inferencias.</data>
</node>
<node id="Prediccion">
  <data key="d0">Inferencia</data>
  <data key="d1">Resultado categórico probabilístico asignado a un documento.</data>
</node>
<node id="EvidenciaBD">
  <data key="d0">Almacenamiento</data>
  <data key="d1">Registro persistente en base de datos SQLite con trazabilidad del procesamiento.</data>
</node>
